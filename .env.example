# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CLOUDFLARE_ACCOUNT_ID: Required for Cloudflare Stream API integration.
CLOUDFLARE_ACCOUNT_ID=MY_CLOUDFLARE_ACCOUNT_ID

# CLOUDFLARE_API_TOKEN: API Token with Stream:Edit permissions for token generation.
CLOUDFLARE_API_TOKEN=MY_CLOUDFLARE_API_TOKEN

# PAYSTACK_SECRET_KEY: Secret key for Paystack payment gateway initialization
PAYSTACK_SECRET_KEY=MY_PAYSTACK_SECRET_KEY

# STRIPE_SECRET_KEY: Secret key for Stripe payment intent creation
STRIPE_SECRET_KEY=MY_STRIPE_SECRET_KEY
